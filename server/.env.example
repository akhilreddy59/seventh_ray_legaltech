# Spring Boot local port
PORT=8080

# Supabase PostgreSQL (use the project pooler host/user if needed)
SUPABASE_DB_URL=jdbc:postgresql://YOUR_PROJECT_POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Supabase Storage (create a private bucket named contracts)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=contracts

# Comma-separated allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_VERCEL_PROJECT.vercel.app

# Optional connection pool setting
DB_POOL_SIZE=5
